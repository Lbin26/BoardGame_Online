[Unit]
Description=DiceGo BoardGame Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dicego
Group=dicego
WorkingDirectory=/opt/dicego/server
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=JAVA_OPTS=-Djava.security.egd=file:/dev/./urandom
# additional-location 覆盖 classpath 内的 application-prod.yml，密码等敏感项只放服务器本地
ExecStart=/usr/bin/java -Djava.security.egd=file:/dev/./urandom -Dserver.port=8080 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:+UseZGC $JAVA_OPTS \
  -jar /opt/dicego/server/dicego.jar \
  --spring.config.additional-location=file:/opt/dicego/config/
Restart=on-failure
RestartSec=10
LimitNOFILE=65535
StandardOutput=append:/opt/dicego/server/console.log
StandardError=append:/opt/dicego/server/console.log

[Install]
WantedBy=multi-user.target
